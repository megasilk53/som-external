// SPDX-License-Identifier: LicenseRef-Ezurio-Clause
/*
 * CTP SDIO DTS for Infineon IF91x — direct M.2 slot
 *
 * For the IF91x DVK board (cable assembly), use imx8mp-ctp-sdio-if91x-dvk instead.
 *
 * The IF91x is a programmable MCU that loads its application from NVRAM at
 * power-on — unlike a standard radio with masked ROM startup.  A 1-second
 * startup delay is required after W_DISABLE2# assertion before the SDIO bus
 * can be enumerated.
 *
 * CTP M.2 W_DISABLE signal routing:
 *   W_DISABLE2# (gpio2 7, SD1_DATA5, ball AA29) — BT_REG_ON, pin 54.
 *     Drives the IF91x MCU internal regulator on the M.2 module.
 *     Used as vmmc-supply to usdhc1 with 1s startup delay.
 *   W_DISABLE1# (gpio2 6, SD1_DATA4, ball U26) — WL_REG_ON, pin 56.
 *     NOT connected on IF91x M.2 module.
 *     Hogged LOW as fail-safe: loading this overlay with the wrong hardware
 *     (DVK) forces W_DISABLE1# LOW so the MCU cannot boot, causing an
 *     immediate SDIO enumeration failure rather than silent misbehaviour.
 *
 * Supply chain:
 *   reg_usdhc1_vmmc (M2_3V3, gpio1 11)
 *     → reg_m2_wdisable2 (W_DISABLE2#, gpio2 7, 1s startup)
 *       → usdhc1 vmmc-supply
 *
 * Copyright 2025-2026 Ezurio
 */

/dts-v1/;

#include "imx8mp-ctp-sdio.dtsi"

/ {
	model = "Summit i.MX8M Plus CTP + IF91x (M.2 direct)";
	compatible = "summit,imx8mp-ctp", "fsl,imx8mp";
};

/*
 * Override the M.2 W_DISABLE2# regulator:
 *   - Remove regulator-always-on so usdhc1 vmmc-supply gates the assertion.
 *   - Add vin-supply chain from M2_3V3.
 *   - Add 1s startup delay for IF91x MCU NVRAM boot time.
 */
&reg_m2_wdisable2 {
	/delete-property/ regulator-always-on;
	vin-supply = <&reg_usdhc1_vmmc>;
	startup-delay-us = <1000000>;
	off-on-delay-us = <100>;
};

&usdhc1 {
	vmmc-supply = <&reg_m2_wdisable2>;
};

/* Hog W_DISABLE1# LOW — not connected on M.2 module; fail-safe for wrong overlay */
&gpio2 {
	wdisable1-force-low-hog {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "W_DISABLE1# forced low (IF91x M.2 module)";
	};
};
